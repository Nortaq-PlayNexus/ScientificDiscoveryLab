# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Raw simulation output: excluded from the publishable copy.
# Regenerable from the seeds in each preregistration. The read-only audit suite
# REQUIRES some of these; see tools/build_publishable.py output. Tests that read
# them fail closed, which is correct behaviour for a read-only audit.
*.npz
*.sqlite3
*.db

# Superseded archive
*.rar

