# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Raw simulation output: excluded from the publishable copy.
# Regenerable from the seeds in each preregistration. The read-only audit suite
# REQUIRES some of these; see tools/build_publishable.py output. Tests that read
# them fail closed, which is correct behaviour for a read-only audit.
*.npz
*.sqlite3
*.db

# Superseded archive
*.rar

# Zenodo upload artifacts. Rebuildable byte-for-byte from this tree with
#   python zenodo/build_zenodo_package.py --tree <dir> --out <path> --verify
# which asserts two independent builds are identical. The canonical copy lives on
# Zenodo; carrying 6.7 MB of it in git history would be permanent and redundant.
# The digests are recorded in zenodo/DEPOSIT_23109117.md.
zenodo/*.zip
zenodo/package.rar

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — never commit
.env
*.key
*.pem
credentials.json
.zenodo_token
*.token