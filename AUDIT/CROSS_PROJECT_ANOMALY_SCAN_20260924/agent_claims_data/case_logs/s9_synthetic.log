          "36: ",
          "37: # Generate dose-response using Hill equation with noise",
          "38: def generate_dose_response(ec50, hill_coeff, max_infl, baseline, n_levels=11):",
          "39:     doses = np.linspace(0, 1, n_levels) * 100  # 0-100%",
          "40:     rates = hill(doses, ec50, hill_coeff, max_infl, baseline)",
